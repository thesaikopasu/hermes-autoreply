# Runtime configuration template.
#
# This file is committed; the real .env never is (it is in .gitignore).
#   cp .env.example .env   and fill in your own values.
#
# Every variable is read from the environment at runtime. On a server
# (Railway, Docker, systemd) the platform injects them and no .env file is
# needed; .env is only a convenience for local runs.
#
# Values are intentionally empty: no real or sample secrets live here.

# --- required ---------------------------------------------------------------

# Numeric API id from https://my.telegram.org -> API development tools
API_ID=

# API hash from the same page on https://my.telegram.org
API_HASH=

# Telethon StringSession of the account that sends the replies, generated once
# with "python generate_session.py" - it is printed a single time. If your
# checkout has no such script, use the snippet in README > "Local setup" step 2.
SESSION_STRING=

# Token of the control bot that delivers the notifications, from @BotFather
BOT_TOKEN=

# Your numeric Telegram user id (send any message to @userinfobot): the control
# bot answers this account only
OWNER_ID=

# --- optional ---------------------------------------------------------------

# Directory holding the sqlite database, logs and pause flag; created at
# startup (default: ./data; the Docker image sets /data - mount a volume there)
DATA_DIR=

# Which incoming messages are reported to the control bot:
# all | offline_only (default: offline_only)
REPORT_MODE=

# Minutes before the same person may be auto-replied to again (default: 10)
COOLDOWN_MINUTES=

# IANA timezone used in reports and daily-report scheduling (default: Asia/Tehran)
TIMEZONE=

# Network proxy for blocked or filtered networks:
#   socks5://user:pass@host:port | http://host:port | host:port:secret (MTProxy)
PROXY=

# Logging verbosity: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=

# StringSession of a second account used only to read the owner's online
# status; leave empty to fall back to the main session for presence checks
WATCHER_SESSION_STRING=
